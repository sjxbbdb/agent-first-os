{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-first-os/semantic-tool/v1",
  "type": "object",
  "required": ["version", "tool_id", "tool_version", "description", "parameters", "required_capabilities", "risk", "reversible", "provider", "verifier"],
  "properties": {
    "version": {"const": 1},
    "tool_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "tool_version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "parameters": {"type": "object"},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "risk": {"enum": ["L0", "L1", "L2", "L3"]},
    "reversible": {"type": "boolean"},
    "provider": {"type": "string", "minLength": 1},
    "verifier": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
